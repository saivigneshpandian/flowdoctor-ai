# Copy to deploy/.env and fill in from the server. DEPLOY.md step 3 shows how to find both.
# The image the server runs today, for example docker.n8n.io/n8nio/n8n:1.2.3
N8N_IMAGE=
# The real volume name from `docker volume ls`, usually <project>_n8n_data
N8N_VOLUME_NAME=

# Accounts. Generate the two keys on the server, once, and keep them:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# docker run --rm python:3.11-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# Changing this later makes every stored n8n key unreadable, so users must reconnect.
ENCRYPTION_KEY=
# Created at startup and linked to N8N_URL / N8N_API_KEY. Existing data moves to this user.
DEMO_EMAIL=
DEMO_PASSWORD=
# Required to sign up. Sign-up is closed while this is empty.
# python3 -c "import secrets; print(secrets.token_urlsafe(12))"
INVITE_CODE=

# Optional. Telegram buttons and replies use polling, which doesn't need this.
TELEGRAM_WEBHOOK_SECRET=

# Optional: show the demo login on the login page. Compiled into the frontend, so changing these
# needs a rebuild. When set, the password is public to every visitor.
NEXT_PUBLIC_DEMO_HINT=false
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
