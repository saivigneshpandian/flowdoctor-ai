# Where /api/* is proxied to. Used on the server side only, at build time.
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=true
# Shows demo credentials on the login page. They are public to every visitor when set.
NEXT_PUBLIC_DEMO_HINT=false
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
