GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional fallback when Gemini returns 429, 503, 504 or times out. Needs both values.
GROQ_API_KEY=
GROQ_MODEL=
# Optional defaults; POST /connect overrides them.
N8N_URL=http://n8n:5678
N8N_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional. Buttons and replies use polling, which doesn't need this. Only for POST /telegram/webhook.
TELEGRAM_WEBHOOK_SECRET=
DATABASE_PATH=./flowdoctor.db

# Accounts. The server won't start without the first two.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this later makes every stored n8n key unreadable, so users must reconnect.
ENCRYPTION_KEY=
# Created at startup and linked to N8N_URL / N8N_API_KEY above. Existing data moves to this user.
DEMO_EMAIL=
DEMO_PASSWORD=
# Sign-up is closed while this is empty. Share it only with people you invite.
INVITE_CODE=
# The cookie is always SameSite=Lax. Set this to true in production, to add Secure.
COOKIE_SECURE=false
# Base of the webhook URL shown to users, through the frontend's proxy: https://app.example.com/api
# An https:// value also turns on Telegram polling. Leave it empty on a laptop sharing the bot token.
PUBLIC_API_URL=
